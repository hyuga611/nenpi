{
  "name": "@hyuga/nenpi",
  "version": "0.1.2",
  "description": "Where a Claude Code session actually burns its tokens. Attributes cache_read spend to the tool output that caused it (residency cost), measures whether your hooks changed anything, and nudges in-session. Zero-dependency, reads only local transcripts.",
  "type": "module",
  "main": "src/nenpi.mjs",
  "exports": {
    ".": "./src/nenpi.mjs"
  },
  "bin": {
    "nenpi": "src/nenpi.mjs"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/nenpi.test.mjs",
    "lint": "npx --yes @biomejs/biome@2.5.8 lint src test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "tokens",
    "token-usage",
    "cache-read",
    "context",
    "cost",
    "observability",
    "hooks",
    "ai",
    "agent",
    "llm",
    "zero-dependency"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "hyuga611",
  "homepage": "https://github.com/hyuga611/nenpi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyuga611/nenpi.git"
  },
  "bugs": {
    "url": "https://github.com/hyuga611/nenpi/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
